# =========================================================================
# Intelligent Customer Service — Environment Variables
# Copy to `.env` and adjust values. All values shown are SAFE placeholders.
# =========================================================================

# ----- App -----
# 注意：这一节的变量必须带 APP_ 前缀才会生效（pydantic-settings 的 env_prefix）。
# 曾经这里写成 DEBUG / PORT / SECRET_KEY，结果被静默忽略 —— 生产环境仍跑在
# debug 模式下。改名字前先确认 src/core/config.py 里的前缀。
APP_NAME=IntelligentCustomerService
APP_ENV=development             # development | production
APP_DEBUG=true                  # 代码默认 false；生产环境务必保持 false（debug 会让异常回显堆栈）
# 后台登录令牌就是用这个 key 签名的。保持默认 = 任何读过本仓库的人都能伪造
# 一个管理员令牌。部署前请换成随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 忘了换也有兜底：APP_ENV=production 时后端拒绝用默认值启动；开发环境会自动
# 生成随机密钥并持久化到 data/.secret_key（重启不掉线）。
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# 检测更新：填了才会启用管理后台的「检测更新」按钮。
# 格式 owner/repo，留空时按钮会提示「未配置仓库」，不会报错。
APP_GITHUB_REPO=vfaner/intelligent-customer-service
# 当前版本号自动读自 backend/pyproject.toml，无需在这里配置 —— 写在 .env 里
# 反而会在 git pull 之后变成一个永远不更新的旧值，让「检测更新」一直报有新版。
# 只有在特殊部署（比如镜像里没带 pyproject.toml）时才需要手动覆盖：
# APP_VERSION=v1.1.1

# ----- Admin login -----
# 管理后台鉴权。/admin/** 与除聊天、会话之外的所有 /api 接口都要求登录。
AUTH_ENABLED=true
# 令牌有效期（小时）。168 = 7 天，改密码会立即让其他设备的令牌失效。
AUTH_TOKEN_TTL_HOURS=168
AUTH_COOKIE_NAME=cs_admin_token
# 只在「用户表为空」时用来创建初始账号；之后改这两个值不会改动已有账号。
# 首次登录后请在后台「用户信息」里改掉密码，忘了密码用：
#   python -m scripts.reset_admin_password
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=123456

# ----- Database -----
# 只能用异步驱动（本项目引擎是异步的）：
#   SQLite（默认，免装）:
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
#   MySQL / TiDB / OceanBase(MySQL 租户) / GaussDB(for MySQL) —— aiomysql：
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/cs_db
#   PostgreSQL —— asyncpg：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cs_db
#   信创库（PG 协议，asyncpg；requirements.txt 已含驱动）：
#     人大金仓 KingbaseES（PG 兼容模式，默认端口 54321）:
# DATABASE_URL=postgresql+asyncpg://system:pass@localhost:54321/security
#     openGauss / 瀚高 HighGo / 海量 Vastbase G100 / GaussDB(PG 版):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cs_db
#   达梦 DM8（默认端口 5236；仅 Linux/Windows，先装信创驱动清单）:
#     pip install -r requirements-xinchuang.txt
# DATABASE_URL=dm+dmAsync://SYSDBA:SYSDBA@localhost:5236/DAMENG
DATABASE_ECHO=false

# ----- Redis (optional; falls back to in-memory cache if disabled) -----
REDIS_URL=
REDIS_ENABLED=false

# ----- Vector DB -----
# chroma | qdrant | milvus
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_COLLECTION=knowledge_base
VECTOR_DB_EMBEDDING_DIM=1024
VECTOR_DB_CHROMA_PERSIST_DIR=./data/chroma_db

# Milvus (only used when VECTOR_DB_PROVIDER=milvus)
#   Local (Milvus Lite, zero-install): a .db file path
#   Server / cluster:                  http://localhost:19530
#   Zilliz Cloud:                      https://xxx.zillizcloud.com + token
VECTOR_DB_MILVUS_URI=./data/milvus.db
VECTOR_DB_MILVUS_PORT=19530
VECTOR_DB_MILVUS_TOKEN=
VECTOR_DB_MILVUS_DB_NAME=

# ----- LLM (active provider — chosen from registry by code) -----
# provider code: deepseek | qwen | bailian | openai | anthropic | doubao |
#                volcengine_ark | qianfan | zhipu | kimi | gemini |
#                shengsuanyun | youyunjisuan | openai_custom | anthropic_custom
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# openai | anthropic
LLM_PROTOCOL=openai

# ----- Embedding -----
# openai_compatible | sentence_transformer (future)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

# ----- RAG -----
# 检索：命中多少条、低于多少分视为不相关
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
RAG_MAX_CONTEXT_CHARS=8000

# 切分：structure = 按章节/标题/Q&A 切（推荐）· window = 按字数硬切
RAG_CHUNK_STRATEGY=structure
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
# 给每个片段加上所属标题前缀，让检索结果自带上下文
RAG_CHUNK_PREFIX_HEADING=true

# 回答策略
#   false（默认）= 只依据知识库回答，检索不到就明确拒答（答案可追溯）
#   true         = 知识库没有相关内容时，允许模型用自身知识回答
RAG_ALLOW_MODEL_KNOWLEDGE=false
# 判定「检索到的内容真的能回答问题」的分数线（仅在上面开关为 true 时使用）。
# 中文 embedding 即使内容无关也有 0.65 左右，所以不能直接用
# SIMILARITY_THRESHOLD 来判断相关性。实测：切题 0.81+，不切题 0.65~0.71。
RAG_RELEVANCE_THRESHOLD=0.76

# ----- Storage -----
APP_UPLOAD_DIR=./uploads
APP_MAX_UPLOAD_MB=20

# ----- CORS -----
# Comma-separated origins or `*` for all
CORS_ORIGINS=*
